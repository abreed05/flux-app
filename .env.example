# Your Black Forest Labs API key (https://dashboard.bfl.ai)
BFL_API_KEY=

# Optional: Anifusion API key for the anime/manga models and character sheets
# (https://anifusion.ai/developers/api/, needs a Creator or Pro plan).
ANIFUSION_API_KEY=
# Refuse any Anifusion job whose estimate is above this many credits.
#ANIFUSION_MAX_CREDITS=200

# Optional overrides (defaults shown)
#BFL_BASE_URL=https://api.bfl.ai
#ANIFUSION_BASE_URL=https://anifusion.ai/api/v1
#PORT=3000

# RabbitMQ connection. docker-compose sets this to amqp://rabbitmq for you;
# for local (non-Docker) dev the default amqp://localhost works with
# `docker compose up rabbitmq`.
#AMQP_URL=amqp://localhost

# Where generated images + run history are stored (a Docker volume in compose).
#OUTPUT_DIR=./outputs

# How many generations each worker runs in parallel.
#WORKER_CONCURRENCY=2

# Tracing (optional). Set an OTLP/HTTP endpoint (an OpenTelemetry Collector,
# Phoenix, Langfuse, …) to export one trace per run; leave unset to disable.
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Public origin of this app, used to link finished images from traces.
#PUBLIC_URL=http://localhost:3000
